@page "/"
@attribute [StreamRendering]
@inject CatalogApiClient CatalogApi

<PageTitle>Aspire — Everyday goods, elevated</PageTitle>

<section class="relative overflow-hidden bg-emerald-950 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-28">
        <div class="relative z-10 max-w-xl">
            <p class="mb-5 text-sm font-bold uppercase tracking-[0.28em] text-amber-300">The everyday edit / 01</p>
            <h1 class="text-5xl font-black leading-[0.95] tracking-[-0.06em] sm:text-7xl">Better things for <span class="text-amber-300">going places.</span></h1>
            <p class="mt-7 max-w-md text-lg leading-8 text-emerald-100">Considered essentials for slow mornings, long weekends, and every adventure in between.</p>
            <div class="mt-9 flex flex-wrap gap-3">
                <a href="#shop" class="rounded-full bg-amber-300 px-6 py-3 text-sm font-bold text-emerald-950 transition hover:bg-amber-200">Shop the collection <span class="ml-2">→</span></a>
                <a href="#story" class="rounded-full border border-emerald-700 px-6 py-3 text-sm font-bold text-white transition hover:border-amber-300 hover:text-amber-300">Our approach</a>
            </div>
        </div>
        <div class="relative mx-auto w-full max-w-lg">
            <div class="aspect-[4/5] rotate-2 rounded-[2rem] bg-amber-300 p-4 shadow-2xl shadow-black/20">
                <div class="flex h-full flex-col justify-between rounded-[1.5rem] bg-[#d4e2d3] p-6 text-emerald-950 sm:p-8">
                    <div class="flex items-start justify-between"><span class="text-xs font-bold uppercase tracking-[0.25em]">Aspire / 2025</span><span class="text-4xl">✦</span></div>
                    <div><p class="text-7xl font-black leading-none tracking-[-0.1em]">GO<br />WELL.</p><p class="mt-5 max-w-[12rem] text-sm font-semibold leading-5">Objects with a little more thought in every detail.</p></div>
                </div>
            </div>
            <div class="absolute -bottom-5 -left-7 rounded-full bg-white px-5 py-3 text-xs font-bold uppercase tracking-wider text-emerald-950 shadow-lg">Made to last ✦</div>
        </div>
    </div>
</section>

<section id="shop" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div><p class="text-sm font-bold uppercase tracking-[0.2em] text-amber-600">Shop by mood</p><h2 class="mt-3 text-4xl font-black tracking-[-0.05em] text-emerald-950">Find your next favorite.</h2></div>
        <span class="text-sm font-bold text-emerald-800">Fresh from the catalog <span class="text-amber-500">✦</span></span>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-800">@errorMessage</div>
    }
    else if (products is null)
    {
        <p class="mt-10 text-stone-500">Loading the collection...</p>
    }
    else
    {
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var product in products)
            {
                <article class="group rounded-3xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                    <div class="flex aspect-[4/3] items-end justify-between rounded-2xl bg-[#d4e2d3] p-5 text-emerald-950">
                        <span class="text-xs font-bold uppercase tracking-[0.2em]">Aspire / essential</span>
                        <span class="text-4xl transition group-hover:rotate-12">✦</span>
                    </div>
                    <div class="flex items-start justify-between gap-4 pt-5">
                        <div><h3 class="text-lg font-black text-emerald-950">@product.Name</h3><p class="mt-1 text-sm text-stone-500">@product.Stock in stock</p></div>
                        <p class="text-lg font-black text-emerald-800">@product.Price.ToString("C")</p>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section id="story" class="bg-amber-300">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8 lg:py-24">
        <div><p class="text-sm font-bold uppercase tracking-[0.2em] text-emerald-900">Why Aspire?</p><h2 class="mt-4 max-w-lg text-4xl font-black leading-tight tracking-[-0.05em] text-emerald-950 sm:text-5xl">Less, but better. Always.</h2></div>
        <p class="max-w-lg text-lg leading-8 text-emerald-950/80">We make useful, beautiful things that earn their place in your life. Small-batch materials, honest details, and designs that get better with time.</p>
    </div>
</section>

@code {
    private IReadOnlyList<CatalogProduct>? products;
    private string? errorMessage;

    private static readonly CreateCatalogProductRequest[] SeedProducts =
    [
        new("Everyday Tote", 68m, 24),
        new("Trail Bottle", 32m, 42),
        new("Weekend Cap", 28m, 18),
        new("Field Notebook", 16m, 60),
        new("Canvas Travel Kit", 44m, 21),
        new("Soft Utility Shirt", 74m, 15),
        new("Camp Mug", 22m, 36),
        new("Daylight Socks", 18m, 50),
        new("Ridge Blanket", 96m, 12),
        new("Pocket Tool", 38m, 27)
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await CatalogApi.GetProductsAsync();

            if (products.Count == 0)
            {
                foreach (var product in SeedProducts)
                {
                    await CatalogApi.CreateProductAsync(product);
                }

                products = await CatalogApi.GetProductsAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The catalog is taking a moment to wake up. Please refresh and try again.";
        }
    }
}
