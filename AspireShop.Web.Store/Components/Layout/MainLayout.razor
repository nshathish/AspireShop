@inherits LayoutComponentBase

<div class="min-h-screen bg-stone-50 text-stone-950">
    <div class="bg-emerald-950 px-4 py-2 text-center text-xs font-semibold uppercase tracking-[0.2em] text-emerald-100">
        Free shipping on orders over $75 <span class="mx-2 text-amber-300">✦</span> Built for everyday adventure
    </div>
    <header class="border-b border-stone-200 bg-stone-50/95 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-5 sm:px-6 lg:px-8">
            <NavMenu />
            <nav class="hidden items-center gap-5 text-sm font-medium text-stone-600 md:flex">
                <a class="transition hover:text-emerald-800" href="/">New arrivals</a>
                <a class="transition hover:text-emerald-800" href="#shop">Shop</a>
                <a class="transition hover:text-emerald-800" href="#story">Our story</a>
            </nav>
            <div class="flex items-center gap-3 text-stone-700">
                <button class="hidden rounded-full p-2 transition hover:bg-stone-200 sm:block" aria-label="Search">⌕</button>
                <button class="rounded-full p-2 transition hover:bg-stone-200" aria-label="Shopping bag">♧<span class="ml-1 text-xs font-bold">0</span></button>
            </div>
        </div>
    </header>
    <main>@Body</main>
    <footer class="border-t border-stone-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 py-8 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
            <p><span class="font-black tracking-tight text-emerald-950">ASPIRE</span> — thoughtfully made goods for the everyday.</p>
            <div class="flex gap-5"><a href="#shop" class="hover:text-emerald-800">Shop</a><a href="#story" class="hover:text-emerald-800">About</a><a href="mailto:hello@aspire.shop" class="hover:text-emerald-800">Contact</a></div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
